NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
COMMERCE_TOKEN_PEPPER=generate_a_long_random_server_only_secret
COMMERCE_QUOTE_TTL_SECONDS=900
COMMERCE_MANDATE_BUFFER_PAISE=250000
COMMERCE_ALLOWED_ORIGINS=https://preview.example.framer.app
COMMERCE_INVENTORY_SOURCE=SUPABASE
COMMERCE_CRON_SECRET=generate_a_long_random_server_only_secret
# Vercel Cron automatically sends CRON_SECRET as the Bearer token. In Vercel
# Production set this to the same value as COMMERCE_CRON_SECRET.
CRON_SECRET=use_the_same_value_as_COMMERCE_CRON_SECRET

RAZORPAY_KEY_ID=rzp_test_or_live_public_key_id
RAZORPAY_KEY_SECRET=your_server_only_key_secret
RAZORPAY_WEBHOOK_SECRET=your_server_only_webhook_secret
